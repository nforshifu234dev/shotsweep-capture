  },
  "dependencies": {
    "@nfsfu234/shotsweep": "^1.2.0",
    "dotenv": "^18.0.3",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@nfsfu234/shotsweep@1.2.0": true
  }
}
