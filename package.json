{
  "name": "@nfsfu234/shotsweep-capture",
  "version": "1.2.2",
  "private": true,
  "description": "Browser capture worker for ShotSweep.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
